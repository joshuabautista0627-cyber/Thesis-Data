{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/live-sensor/session_manifest.schema.json",
  "title": "Live sensor session manifest row",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "study_config_hash", "source_manifest_hash", "created_by_run_id", "archive_id", "archive_role", "archive_sha256", "zip_member_root", "collection_day", "session_id", "target_roi", "contact_role", "scientific_role", "layout_id", "inclusion_status", "integrity_result"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_config_hash": {"$ref": "#/$defs/hash"},
    "source_manifest_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"const": "pending-self-hash"}]},
    "created_by_run_id": {"type": "string", "minLength": 1},
    "archive_id": {"enum": ["manual", "automated"]},
    "archive_role": {"enum": ["model_primary", "characterization"]},
    "archive_sha256": {"$ref": "#/$defs/hash"},
    "zip_member_root": {"type": "string", "minLength": 1},
    "collection_day": {"type": "string", "format": "date"},
    "session_id": {"type": "string", "minLength": 1},
    "test_group": {"type": ["string", "null"]},
    "target_roi": {"type": ["integer", "null"], "minimum": 1, "maximum": 9},
    "contact_role": {"enum": ["contact", "no_contact", "mixed_protocol", "unknown"]},
    "speed_mm_min": {"type": ["number", "null"]},
    "displacement_mm": {"type": ["number", "null"]},
    "cycle_plan": {"type": ["integer", "null"], "minimum": 0},
    "layout_id": {"const": "roi-9fbc67c50ee3bc7145fa"},
    "baseline_id": {"type": ["string", "null"]},
    "source_video_member": {"type": ["string", "null"]},
    "master_csv_member": {"type": ["string", "null"]},
    "video_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "video_crc32": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}$"},
    "video_frame_count": {"type": ["integer", "null"], "minimum": 0},
    "master_row_count": {"type": ["integer", "null"], "minimum": 0},
    "raw_width": {"type": ["integer", "null"], "minimum": 1},
    "raw_height": {"type": ["integer", "null"], "minimum": 1},
    "oriented_width": {"type": ["integer", "null"], "minimum": 1},
    "oriented_height": {"type": ["integer", "null"], "minimum": 1},
    "inclusion_status": {"enum": ["included", "excluded", "pending"]},
    "reason_code": {"type": ["string", "null"]},
    "scientific_role": {"enum": ["model_primary", "characterization", "no_contact", "replay_only", "excluded"]},
    "integrity_result": {"enum": ["pass", "fail", "warning"]},
    "notes": {"type": "string"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
