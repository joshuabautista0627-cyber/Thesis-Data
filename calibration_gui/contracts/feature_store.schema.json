{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/live-sensor/feature_store.schema.json",
  "title": "Immutable optical frame feature row",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "study_config_hash", "source_manifest_hash", "created_by_run_id", "frame_uid", "archive_id", "session_id", "frame_id", "video_decode_status", "exclusion_reason", "target_roi", "reference_force_raw_N", "reference_force_corrected_N", "force_valid", "baseline_id", "baseline_hash", "layout_id", "raw_width", "raw_height", "oriented_width", "oriented_height"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_config_hash": {"$ref": "#/$defs/hash"},
    "source_manifest_hash": {"$ref": "#/$defs/hash"},
    "created_by_run_id": {"type": "string", "minLength": 1},
    "frame_uid": {"type": "string", "minLength": 1},
    "archive_id": {"enum": ["manual", "automated"]},
    "collection_day": {"type": "string", "format": "date"},
    "test_group": {"type": ["string", "null"]},
    "session_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 0},
    "capture_monotonic_relative_s": {"type": ["number", "null"]},
    "synchronized_monotonic_relative_s": {"type": ["number", "null"]},
    "source_timestamp_quality": {"enum": ["device", "host", "derived", "missing"]},
    "video_decode_status": {"enum": ["decoded", "missing", "corrupt", "not_attempted"]},
    "exclusion_reason": {"type": ["string", "null"]},
    "target_roi": {"type": ["integer", "null"], "minimum": 1, "maximum": 9},
    "reference_force_raw_N": {"type": ["number", "null"]},
    "reference_force_corrected_N": {"type": ["number", "null"]},
    "force_valid": {"type": "boolean"},
    "motion_phase": {"type": ["string", "null"]},
    "cycle_id": {"type": ["string", "null"]},
    "cycle_index": {"type": ["integer", "null"], "minimum": 0},
    "speed_mm_min": {"type": ["number", "null"]},
    "displacement_mm": {"type": ["number", "null"]},
    "synchronization_residual_ms": {"type": ["number", "null"]},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_hash": {"$ref": "#/$defs/hash"},
    "layout_id": {"const": "roi-9fbc67c50ee3bc7145fa"},
    "raw_width": {"const": 640},
    "raw_height": {"const": 480},
    "oriented_width": {"const": 480},
    "oriented_height": {"const": 640}
  },
  "patternProperties": {
    "^roi[1-9]_(x|y|width|height|area|signed_delta_v_sum|signed_delta_v_mean|signed_delta_v_median|signed_delta_v_mad|positive_delta_sum|positive_delta_mean|active_fraction|centroid_x|centroid_y|raw_v_mean|raw_v_median|raw_v_max)$": {"type": ["number", "integer", "null"]}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
